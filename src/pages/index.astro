---
import About from "../components/About.astro";
import BoatLifts from "../components/BoatLifts.astro";
import ContactCTA from "../components/ContactCTA.astro";
import Footer from "../components/Footer.astro";
import Gallery from "../components/Gallery.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Services from "../components/Services.astro";
import { business, site } from "../data/content";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`${business.name} | ${site.pageTitleSuffix} in ${business.address.city}, ${business.address.state}`}
  description={site.pageDescription}
>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Gallery client:visible />
    <BoatLifts />
    <ContactCTA />
  </main>
  <Footer />
</Layout>
