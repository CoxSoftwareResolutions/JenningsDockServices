---
import About from '../components/About.astro';
import BoatLifts from '../components/BoatLifts.astro';
import ContactCTA from '../components/ContactCTA.astro';
import Footer from '../components/Footer.astro';
import Gallery from '../components/Gallery.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import { business } from '../data/content';
import Layout from '../layouts/Layout.astro';
---

<Layout
  title={`${business.name} | Boat Docks, Lifts & Marine Repair in ${business.address.city}, ${business.address.state}`}
  description="Family-owned dock and boat lift specialists with 25+ years of experience. Galvanized steel docks, lift installation and repair, wood and steel dock repair, anchor and cable work, and scuba recovery."
>
  <Header />
  <main id="main">
    <Hero />
    <About />
    <Services />
    <Gallery />
    <BoatLifts />
    <ContactCTA />
  </main>
  <Footer />
</Layout>