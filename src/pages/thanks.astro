---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { business, telHref } from "../data/content";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`Thank You | ${business.name}`}
  description="Your estimate request has been received. We will be in touch shortly."
>
  <Header />
  <main id="main" class="section thanks">
    <div class="container thanks__inner">
      <p class="eyebrow">Request Received</p>
      <h1>Thanks &mdash; we got your message.</h1>
      <p class="section-subtitle">
        An employee will follow up during business hours ({business.hours}). If
        it is urgent, give us a call directly.
      </p>
      <div class="thanks__actions">
        <a class="btn btn--primary" href={telHref}>Call {business.phone}</a>
        <a class="btn btn--ghost" href="/">Back to Home</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .thanks__inner {
    max-width: 640px;
    text-align: center;
    padding-block: clamp(1rem, 6vw, 4rem);
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
