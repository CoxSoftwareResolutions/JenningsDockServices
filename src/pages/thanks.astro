---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { business, site, telHref } from "../data/content";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`Thank You | ${business.name}`}
  description="Your estimate request has been received. We will be in touch shortly."
>
  <Header />
  <main id="main" class="section thanks">
    <div class="container thanks__inner">
      <p class="eyebrow">{site.thanksEyebrow}</p>
      <h1>{site.thanksTitle}</h1>
      <p class="section-subtitle">
        {site.thanksSubtitle} ({business.hours})
      </p>
      <div class="thanks__actions">
        <a class="btn btn--primary" href={telHref}>Call {business.phone}</a>
        <a class="btn btn--ghost" href="/">{site.backHome}</a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .thanks__inner {
    max-width: 640px;
    text-align: center;
    padding-block: clamp(1rem, 6vw, 4rem);
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>
