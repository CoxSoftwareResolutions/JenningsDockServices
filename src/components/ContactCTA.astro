---
import {
  business,
  fullAddress,
  mailHref,
  site,
  telHref,
} from "../data/content";
---

<section class="section section--dark" id="contact">
  <div class="container contact">
    <div class="contact__intro">
      <p class="eyebrow">{site.contactEyebrow}</p>
      <h2>{site.contactTitle}</h2>
      <p class="section-subtitle">{site.contactSubtitle}</p>

      <div class="contact__actions">
        <a class="btn btn--primary" href={telHref}
          >{site.callButtonPrefix} {business.phone}</a
        >
        <a class="btn btn--outline" href={mailHref}>{site.emailButton}</a>
      </div>

      <dl class="contact__details">
        <div>
          <dt>{site.hoursLabel}</dt>
          <dd>{business.hours}</dd>
        </div>
        <div>
          <dt>{site.serviceAreaLabel}</dt>
          <dd>{business.location}</dd>
        </div>
        <div>
          <dt>{site.addressLabel}</dt>
          <dd>{fullAddress}</dd>
        </div>
      </dl>
    </div>

    <style>
      .contact__actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        margin: 2rem 0;
      }

      .contact__details {
        display: grid;
        gap: 1.1rem;
        margin: 0;
        padding-top: 1.75rem;
        border-top: 1px solid rgba(255, 255, 255, 0.18);
      }

      .contact__details dt {
        font-family: var(--font-heading);
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--color-accent-subtle);
        margin-bottom: 0.15rem;
      }

      .contact__details dd {
        margin: 0;
        font-size: 0.98rem;
      }

      .hidden-field {
        display: none;
      }

      @media (max-width: 860px) {
        .contact {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </div>
</section>
