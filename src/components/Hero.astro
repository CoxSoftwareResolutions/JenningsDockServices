---
import { business, hero, mailHref, site, telHref } from "../data/content";

// Escape characters that could break out of the CSS url() literal.
const safeBgImage = hero.bgImage.replace(/["')\\]/g, encodeURIComponent);
const bgStyle = hero.bgImage
  ? `background-image: url("${safeBgImage}")`
  : undefined;
---

<section
  class="hero"
  id="top"
  data-has-image={hero.bgImage ? "true" : "false"}
  style={bgStyle}
>
  <div class="hero__overlay"></div>
  <div class="container hero__inner">
    <p class="hero__eyebrow">{site.heroEyebrow}</p>
    <h1 class="hero__headline">{hero.headline}</h1>
    <p class="hero__subheadline">{hero.subheadline}</p>

    <div class="hero__actions">
      <a class="btn btn--primary" href={telHref}>{hero.ctaText}</a>
      <a class="btn btn--outline" href={mailHref}>{site.emailButton}</a>
    </div>

    <ul class="hero__meta">
      <li>{business.phone}</li>
      <li>{business.hours}</li>
      <li>{business.location}</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background-color: var(--color-primary);
    background-size: cover;
    background-position: center;
    color: var(--color-white);
    padding-block: clamp(4rem, 11vw, 8rem);
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      rgba(26, 51, 62, 0.94) 0%,
      rgba(26, 51, 62, 0.78) 55%,
      rgba(59, 88, 76, 0.7) 100%
    );
  }

  .hero[data-has-image="false"] .hero__overlay {
    background:
      radial-gradient(
        120% 100% at 15% 0%,
        rgba(59, 88, 76, 0.55) 0%,
        rgba(26, 51, 62, 0) 60%
      ),
      linear-gradient(160deg, #1a333e 0%, #14272f 100%);
  }

  .hero__inner {
    max-width: 780px;
    margin-inline: 0;
    padding-inline: 1.25rem;
  }

  @media (min-width: 1180px) {
    .hero__inner {
      margin-inline: auto;
      max-width: var(--max-width);
    }

    .hero__headline,
    .hero__subheadline,
    .hero__eyebrow {
      max-width: 780px;
    }
  }

  .hero__eyebrow {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-subtle);
    margin-bottom: 1rem;
  }

  .hero__headline {
    color: var(--color-white);
    margin-bottom: 1rem;
  }

  .hero__subheadline {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: color-mix(in srgb, var(--color-white) 88%, transparent);
    max-width: 60ch;
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 2.5rem;
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    font-size: 0.9rem;
    color: var(--color-accent-subtle);
  }

  .hero__meta li {
    position: relative;
    padding-left: 1.15rem;
  }

  .hero__meta li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: var(--color-cta);
  }

  @media (max-width: 480px) {
    .hero__actions .btn {
      width: 100%;
    }
  }
</style>
